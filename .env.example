# Required for Telegram Mini App authentication and reminder delivery.
TELEGRAM_BOT_TOKEN=

# Optional comma-separated Telegram user IDs that receive the server-side admin role.
TELEGRAM_ADMIN_IDS=

# Secret configured in setWebhook(secret_token=...) for payment updates.
TELEGRAM_WEBHOOK_SECRET=

# Invoice link created by the Telegram bot for the Premium plan.
TELEGRAM_PREMIUM_INVOICE_URL=

# Bearer token used by an external scheduler for /api/cron/reminders.
CRON_SECRET=
